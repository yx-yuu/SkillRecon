{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "skill_id",
    "kind",
    "artifact",
    "key_fields",
    "gold_keys"
  ],
  "properties": {
    "skill_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "artifact": {
      "type": "string"
    },
    "key_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relation": {
      "type": "string"
    },
    "gold_keys": {
      "type": "array",
      "items": {
        "type": "array"
      }
    }
  }
}
