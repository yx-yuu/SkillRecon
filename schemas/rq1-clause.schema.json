{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "skill_id",
    "clause_id",
    "gold"
  ],
  "properties": {
    "skill_id": {
      "type": "string"
    },
    "clause_id": {
      "type": "string"
    },
    "gold": {
      "type": "object",
      "required": [
        "operator",
        "role"
      ],
      "properties": {
        "operator": {
          "enum": [
            "allowed",
            "prohibited",
            "unknown"
          ]
        },
        "role": {
          "enum": [
            "policy",
            "knowledge"
          ]
        }
      }
    }
  }
}
