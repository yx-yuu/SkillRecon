{
  "version": "v1",
  "description": "Tier 3 vocabulary for literal Shell command positions and resource syntax. Operation observations, resource resolution, cross-file routes, and payload-flow traces are recorded separately.",
  "patterns": {
    "http_request": {
      "commands": [
        "curl",
        "wget",
        "httpie",
        "http"
      ],
      "notes": "HTTP client commands"
    },
    "ssh_connect": {
      "commands": [
        "ssh",
        "scp",
        "sftp",
        "rsync"
      ],
      "notes": "Remote shell and file transfer"
    },
    "file_delete": {
      "commands": [
        "rm",
        "rmdir",
        "shred"
      ],
      "notes": "File/directory removal"
    },
    "file_permission_change": {
      "commands": [
        "chmod",
        "chown",
        "chgrp"
      ],
      "notes": "Permission and ownership changes"
    },
    "shell_exec": {
      "commands": [
        "bash",
        "sh",
        "zsh",
        "eval",
        "source",
        ".",
        "python",
        "python3",
        "node",
        "nodejs",
        "deno",
        "ruby",
        "uv run",
        "poetry run",
        "npx"
      ],
      "notes": "Shell invocation and script sourcing"
    },
    "subprocess": {
      "commands": [
        "nohup",
        "screen",
        "tmux",
        "xargs"
      ],
      "notes": "Background/detached process spawning"
    },
    "env_var_read": {
      "commands": [
        "printenv"
      ],
      "notes": "Parsed shell expansions with ordered assignments and scope-aware variable provenance; exporting a local value is not an environment input read"
    },
    "cron_write": {
      "commands": [
        "crontab",
        "at",
        "batch"
      ],
      "notes": "Task scheduling"
    },
    "file_write": {
      "patterns": [
        ">\\s+",
        ">>\\s+",
        "tee\\s+"
      ],
      "notes": "Output redirection and tee"
    },
    "data_encode": {
      "commands": [
        "base64",
        "xxd",
        "openssl enc"
      ],
      "notes": "Data encoding commands"
    },
    "dns_query": {
      "commands": [
        "dig",
        "nslookup",
        "host"
      ],
      "notes": "DNS query commands"
    },
    "process_kill": {
      "commands": [
        "kill",
        "killall",
        "pkill"
      ],
      "notes": "Process termination"
    },
    "dynamic_import": {
      "commands": [
        "pip install",
        "pip3 install",
        "python -m pip install",
        "python3 -m pip install",
        "npm install",
        "npm ci",
        "yarn add",
        "pnpm add",
        "pnpm install",
        "uv pip install",
        "uv add",
        "uv sync",
        "poetry add",
        "poetry install"
      ],
      "notes": "Package installation (runtime dependency injection)"
    },
    "daemon_spawn": {
      "commands": [
        "systemctl",
        "service",
        "launchctl"
      ],
      "notes": "System service management"
    }
  }
}
